<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grey_light"
    android:padding="30dp"
    android:gravity="center">

    <!-- LOGO UCOMPENSAR -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="220dp"
        android:layout_height="100dp"
        android:src="@drawable/logo_ucompensar"
        android:contentDescription="Logo UCompensar"
        android:scaleType="fitCenter"
        android:layout_marginBottom="20dp" />

    <!-- TÍTULO (AZUL COMPENSAR) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inicio de sesión"
        android:textColor="@color/ucompensar_blue"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="30dp" />

    <!-- CORREO -->
    <EditText
        android:id="@+id/etCorreo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Correo electrónico"
        android:textColorHint="@color/grey_dark"
        android:textColor="@color/black"
        android:backgroundTint="@color/ucompensar_blue"
        android:inputType="textEmailAddress" />

    <!-- CONTRASEÑA -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Contraseña"
        android:textColorHint="@color/grey_dark"
        android:textColor="@color/black"
        android:backgroundTint="@color/ucompensar_blue"
        android:inputType="textPassword"
        android:layout_marginTop="15dp" />

    <!-- BOTÓN INGRESAR (NARANJA COMPENSAR) -->
    <Button
        android:id="@+id/btnIngresar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INGRESAR"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/ucompensar_orange"
        android:layout_marginTop="25dp" />

    <!-- BOTÓN CREAR CUENTA (AZUL COMPENSAR) -->
    <Button
        android:id="@+id/btnCrearCuenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CREAR CUENTA"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/ucompensar_blue"
        android:layout_marginTop="10dp" />

    <!-- MENSAJE -->
    <TextView
        android:id="@+id/tvMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/ucompensar_orange"
        android:gravity="center"
        android:textSize="18sp"
        android:layout_marginTop="20dp" />

</LinearLayout>
